generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model admin_log {
  id         Int      @id @default(autoincrement())
  admin_id   Int?
  method     String   @db.VarChar(255)
  created_at DateTime @default(now()) @db.Timestamp(0)
  admins     admins?  @relation(fields: [admin_id], references: [id], map: "admin_log_ibfk_1")

  @@index([admin_id], map: "admin_log_ibfk_1")
}

model admins {
  id                  Int          @id @default(autoincrement())
  username            String       @unique(map: "uq_admins_username") @db.VarChar(255)
  email               String       @unique(map: "uq_admins_email") @db.VarChar(255)
  password            String       @db.VarChar(255)
  role                admins_role
  status              admin_status @default(ACTIVE)
  profile_photo_path  String?      @db.VarChar(255)
  password_changed_at DateTime?    @db.DateTime(0)
  created_at          DateTime     @default(now()) @db.Timestamp(0)
  updated_at          DateTime     @default(now()) @db.Timestamp(0)
  admin_log           admin_log[]
}

model clinics {
  id           Int            @id @default(autoincrement())
  clinic_name  String         @unique(map: "uq_clinics_name") @db.VarChar(255)
  is_active    Boolean        @default(true)
  created_at   DateTime       @default(now()) @db.Timestamp(0)
  updated_at   DateTime       @default(now()) @db.Timestamp(0)
  reservations reservations[]
}

model external_hospitals {
  id            Int         @id @default(autoincrement())
  hospital_name String      @unique(map: "uq_hospitals_name") @db.VarChar(255)
  is_active     Boolean     @default(true)
  created_at    DateTime    @default(now()) @db.Timestamp(0)
  updated_at    DateTime    @default(now()) @db.Timestamp(0)
  transfers     transfers[]
}

model faculties {
  id           Int      @id @default(autoincrement())
  faculty_name String   @unique(map: "uq_faculties_name") @db.VarChar(255)
  is_active    Boolean  @default(true)
  created_at   DateTime @default(now()) @db.Timestamp(0)
  updated_at   DateTime @default(now()) @db.Timestamp(0)
  users        users[]
}

model governorates {
  id         Int      @id @default(autoincrement())
  gov_name   String   @unique(map: "uq_governorates_name") @db.VarChar(255)
  is_active  Boolean  @default(true)
  created_at DateTime @default(now()) @db.Timestamp(0)
  updated_at DateTime @default(now()) @db.Timestamp(0)
  users      users[]
}

model laboratory {
  id              Int                    @id @default(autoincrement())
  user_id         Int?
  reservation_id  Int
  medical_test_id Int
  test_result     laboratory_test_result
  users           users?                 @relation(fields: [user_id], references: [id], onDelete: NoAction, map: "laboratory_ibfk_1")
  reservations    reservations           @relation(fields: [reservation_id], references: [id], onDelete: NoAction, map: "laboratory_ibfk_2")
  medical_tests   medical_tests          @relation(fields: [medical_test_id], references: [id], onDelete: NoAction, map: "laboratory_ibfk_3")

  @@index([reservation_id], map: "reservation_id")
  @@index([medical_test_id], map: "medical_test_id")
  @@index([user_id], map: "user_id")
}

model levels {
  id         Int      @id @default(autoincrement())
  level_name String   @unique(map: "uq_levels_name") @db.VarChar(255)
  is_active  Boolean  @default(true)
  created_at DateTime @default(now()) @db.Timestamp(0)
  updated_at DateTime @default(now()) @db.Timestamp(0)
  users      users[]
}

model medical_tests {
  id         Int                     @id @default(autoincrement())
  test_name  String                  @unique(map: "uq_medical_tests_name") @db.VarChar(255)
  test_type  medical_tests_test_type
  state      medical_tests_state
  created_at DateTime                @default(now()) @db.Timestamp(0)
  updated_at DateTime                @default(now()) @db.Timestamp(0)
  laboratory laboratory[]
}

model nationality {
  id               Int      @id @default(autoincrement())
  nationality_name String   @unique(map: "uq_nationality_name") @db.VarChar(255)
  is_active        Boolean  @default(true)
  created_at       DateTime @default(now()) @db.Timestamp(0)
  updated_at       DateTime @default(now()) @db.Timestamp(0)
  users            users[]
}

model password_reset_otps {
  email          String   @id @db.VarChar(255)
  otp_hash       String   @db.VarChar(255)
  expires_at     DateTime @db.DateTime(0)
  attempts_count Int      @default(0)
  used           Boolean  @default(false)
  last_sent_at   DateTime @default(now()) @db.DateTime(0)
  created_at     DateTime @default(now()) @db.DateTime(0)
  updated_at     DateTime @default(now()) @db.DateTime(0)
}

model email_verification_otps {
  email          String   @id @db.VarChar(255)
  otp_hash       String   @db.VarChar(255)
  expires_at     DateTime @db.DateTime(0)
  attempts_count Int      @default(0)
  used           Boolean  @default(false)
  last_sent_at   DateTime @default(now()) @db.DateTime(0)
  created_at     DateTime @default(now()) @db.DateTime(0)
  updated_at     DateTime @default(now()) @db.DateTime(0)
}

model reservations {
  id           Int                    @id @default(autoincrement())
  user_id      Int?
  patient_name String?                @db.VarChar(255)
  national_id  String?                @db.VarChar(14)
  phone_number String?                @db.VarChar(255)
  clinic_id    Int?
  exam_type    reservations_exam_type @default(EMERGENCY)
  status       reservations_status    @default(PENDING)
  date         DateTime               @default(now()) @db.DateTime(0)
  created_at   DateTime               @default(now()) @db.Timestamp(0)
  updated_at   DateTime               @default(now()) @db.Timestamp(0)
  laboratory   laboratory[]
  users        users?                 @relation(fields: [user_id], references: [id], onDelete: NoAction, map: "reservations_ibfk_1")
  clinics      clinics?               @relation(fields: [clinic_id], references: [id], onDelete: NoAction, map: "reservations_ibfk_2")
  transfers    transfers[]

  @@index([clinic_id], map: "clinic_id")
  @@index([user_id], map: "user_id")
}

model users {
  id                  Int                    @id @default(autoincrement())
  username            String                 @db.VarChar(255)
  email               String                 @unique(map: "uq_users_email") @db.VarChar(255)
  password            String                 @db.VarChar(255)
  national_id         String                 @unique(map: "uq_users_national_id") @db.VarChar(14)
  nationality_id      Int
  level_id            Int
  gov_id              Int
  faculty_id          Int
  gender              users_gender
  birth_date          DateTime               @db.Date
  phone_number        String                 @unique(map: "uq_users_phone") @db.VarChar(255)
  verified            Boolean                @default(false)
  is_active           Boolean                @default(false)
  document_status     user_document_status   @default(pending)
  rejection_reason    String?                @db.VarChar(500)
  reviewed_by         Int?
  reviewed_at         DateTime?              @db.DateTime(0)
  user_image_path     String                 @db.VarChar(255)
  national_id_path    String                 @db.VarChar(255)
  fees_path           String                 @db.VarChar(255)
  password_changed_at DateTime?              @db.DateTime(0)
  created_at          DateTime               @default(now()) @db.Timestamp(0)
  updated_at          DateTime               @default(now()) @db.Timestamp(0)
  laboratory          laboratory[]
  reservations        reservations[]
  nationality         nationality            @relation(fields: [nationality_id], references: [id], onDelete: NoAction, map: "users_ibfk_1")
  levels              levels                 @relation(fields: [level_id], references: [id], onDelete: NoAction, map: "users_ibfk_2")
  governorates        governorates           @relation(fields: [gov_id], references: [id], onDelete: NoAction, map: "users_ibfk_3")
  faculties           faculties              @relation(fields: [faculty_id], references: [id], onDelete: NoAction, map: "users_ibfk_4")

  @@index([faculty_id], map: "faculty_id")
  @@index([gov_id], map: "gov_id")
  @@index([level_id], map: "level_id")
  @@index([nationality_id, level_id, gov_id, faculty_id], map: "nationality_id")
}

model transfers {
  id                 Int                @id @default(autoincrement())
  reservation_id     Int
  hospital_id        Int
  transfer_reason    String             @db.VarChar(500)
  notes              String?            @db.VarChar(500)
  status             transfers_status   @default(pending)
  created_at         DateTime           @default(now()) @db.Timestamp(0)
  updated_at         DateTime           @default(now()) @db.Timestamp(0)
  reservations       reservations       @relation(fields: [reservation_id], references: [id], onDelete: NoAction, map: "transfers_ibfk_1")
  external_hospitals external_hospitals @relation(fields: [hospital_id], references: [id], onDelete: NoAction, map: "transfers_ibfk_2")

  @@index([hospital_id], map: "hospital_id")
  @@index([reservation_id], map: "reservation_id")
  @@index([reservation_id, hospital_id], map: "transfer_res_hospital_idx")
}

enum admin_status {
  ACTIVE   @map("active")
  INACTIVE @map("inactive")
}

enum admins_role {
  SUPER_ADMIN
  MEDICAL_TESTS_MANAGER
  MEDICAL_CHECK_MANAGER
  COUNTER
  TRANSFER_CLERK
  OBSERVER
}

enum medical_tests_test_type {
  STOOL   @map("براز")
  BLOOD   @map("دم")
  CULTURE @map("مزرعة")
  URINE   @map("بول")
}

enum reservations_exam_type {
  EMERGENCY @map("طواريْ")
  FOLLOW_UP @map("متابعة")
  NEW_EXAM  @map("كشف جديد")
}

enum medical_tests_state {
  AVAILABLE   @map("متاح")
  UNAVAILABLE @map("غير متاح")
}

enum laboratory_test_result {
  POSITIVE @map("إيجابي")
  NEGATIVE @map("سلبي")
}

enum reservations_status {
  ACCEPTED @map("مقبول")
  PENDING  @map("تحت الانتظار")
  REJECTED @map("مرفوض")
}

enum transfers_status {
  pending
  accepted
  completed
  rejected
}

enum users_gender {
  MALE   @map("ذكر")
  FEMALE @map("أنثي")
}

enum user_document_status {
  pending
  approved
  rejected
}
